@model PVSolrSystemPrivate.Models.ConsumptionCustomer
@{
    var months = ViewBag.Months as List<string> ?? new List<string>();
    var monthsJson = Json.Serialize(months); // Serialize months to JSON

    int startIndex = (DateTime.Now.Month - 2 + months.Count) % months.Count;

    var solarValues = ViewBag.SolarValues as List<double> ?? new List<double>();
}

<!DOCTYPE html>
<html lang="ar">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>حساب فاتورة الكهرباء</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .watermark {
            position: absolute; /* جعلها ثابتة في الخلفية */
            top: 50%; /* محاذاة عمودية */
            left: 50%; /* محاذاة أفقية */
            transform: translate(-50%, -50%); /* مركز الشعار */
            opacity: 0.5; /* جعل الشعار شفافًا */
            pointer-events: none; /* عدم التداخل مع التفاعلات */
            z-index: 0; /* وضعها خلف المحتوى */
        }

            .watermark img {
                max-width: 100%; /* جعل الشعار يتناسب مع عرض الحاوية */
                height: auto; /* الحفاظ على نسبة العرض إلى الارتفاع */
                width: 800px;
            }

        .logo {
            text-align: left; /* Align the logo to the left */
        }


        .logo-img {
            max-width: 100%; /* Ensure the image is responsive */
            height: auto;
        }

        body {
            font-family: 'Noto Sans Arabic', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f9; /* لون الخلفية */
            color: #333; /* لون النص */
            margin: 0;
            padding: 0;
            direction: rtl;
            text-align: right;
        }

        .container {
            max-width: 1200px;
            margin: 20px auto;
            background-color: #fff;
            border-radius: 12px;
            padding: 20px 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            position: relative;
        }


        h2 {
            text-align: center;
            color: #333; /* لون العنوان */
            font-size: 28px;
            margin-bottom: 30px;
        }

        h4 {
            text-align: center;
            color: #333; /* لون العنوان */
            font-size: 24px;
            margin-bottom: 30px;
            margin-top: 80px;
            margin-bottom: 50px;
        }



        label {
            display: block;
            font-weight: bold;
            font-size: 18px;
            margin-top: 20px
        }

        input[type="text"],
        input[type="number"],
        select {
            color: #495057;
            width: 100%;
            padding: 3px;
            border: 1px solid #ddd;
            border-radius: 16px;
            font-size: 18px;
            box-sizing: border-box; /* Ensures padding and border are included in the element's total width and height */
            appearance: none; /* Removes default styling for select */
            -webkit-appearance: none; /* For Safari */
            -moz-appearance: none; /* For Firefox */
            background-color: #fff; /* Ensures a consistent background color */
        }

            /* Optional: Add hover and focus styles for better user experience */
            input[type="text"]:focus,
            input[type="number"]:focus,
            select:focus {
                border-color: #007bff; /* Change border color on focus */
                outline: none; /* Remove default outline */
            }



        input[type="radio"] {
            margin-right: 10px;
        }

        .section {
            margin-top: 25px;
        }

            .section.hidden {
                display: none;
            }

        .result-table {
            margin-top: 15px;
        }

        .positive-value {
            color: #28a745;
        }

        .negative-value {
            color: #dc3545;
        }

        .highlighted-text {
            color: #e63946;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

            table th,
            table td {
                border: 1px solid #ddd;
                padding: 10px;
                text-align: center;
            }

            table th {
                background-color: #4FA647;
                color: #ffffff;
                font-weight: 750;
                font-size: 18px;
            }

            table tbody tr:nth-child(even) {
                background-color: #f9f9f9;
            }

        .total-row {
            background-color: #4FA647;
            color: #ffffff;
            font-weight: bold;
        }

        .hover-button {
            display: inline-block;
            padding: 10px 20px;
            margin: 5px;
            background-color: white;
            color: #4FA647;
            border: 2px solid #4FA647;
            border-radius: 12px;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
        }

            .hover-button:hover {
                background-color: #4FA647;
                color: white;
            }

        .chart-container {
            max-width: 900px;
            margin: 30px auto;
        }

        .toggle-chart-btn {
            display: inline-block;
            padding: 10px 20px;
            margin-bottom: 50px;
            margin-top: 50px;
            background-color: white;
            color: #4FA647;
            border: 2px solid #4FA647;
            border-radius: 16px;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
        }

            .toggle-chart-btn:hover {
                background-color: #4FA647;
                color: white;
            }

        .info-icon {
            cursor: pointer;
            margin-left: 5px;
            color: #ddd;
        }

            .info-icon:hover {
                color: #e64a19;
            }

        .note {
            margin-top: 20px;
            font-size: 16px;
            color: #555;
            text-align: center;
        }

            .note i {
                color: #326e24;
                margin-right: 5px;
            }

        row {
            justify-content: space-between;
        }

        /* تأكد من عدم وجود خصائص CSS تؤثر على الـ modal */
        .modal-content {
            background-color: #ffffff; /* خلفية بيضاء */
            color: #000000; /* نص أسود */
        }

        #calculateButton {
            border-radius: 16px;
            width: 100%;
            background-color: #4FA647;
            color: #fff;
            border: none;
            transition: background-color 0.3s ease;
            margin-top: 50px;
            height: 50px;
            font-size: 18px;
            font-weight: 400;
        }
    </style>

</head>

<body>
    <div class="watermark">
        <img src="~/img/EBSHER-logo.png" alt="EBSHER Logo" />
    </div>
    <div class="container">
        <div class="row align-items-center">
            <!-- Logo on the left -->
            <!-- Title next to the logo -->
            <div class="col">
                <h2 class="text-center" style="color:#067406; font-size:22px;margin-top:30px; text-align:start!important;">
                    ابشر لأنظمة الطاقة و الكهروميكانيك
                </h2>
            </div>
            <div class="col-6">
                <div class="logo">
                    <img src="~/img/logo2.png" alt="EBSHER Logo" class="logo-img" />
                </div>
            </div>
        </div>

        <h2 class="text-center">حساب فاتورة الكهرباء </h2>

        <div class="form-group">
            <label for="name">اسم المشترك:</label>
            <input asp-for="Name" class="form-control" placeholder="أدخل اسم المشترك" />
        </div>



        <div class="form-group row">
            <div class="col-md-12" id="consumptionTypeDiv">
                <label for="consumptionType">نوع الاستهلاك:</label>
                <select id="consumptionType">
                    <option value="0" disabled selected>اختر نوع الاشتراك</option>
                    <option value="منزلي">منزلي</option>
                    <option value="تجاري">تجاري</option>
                    <option value="صناعي صغير">صناعي صغير</option>
                    <option value="صناعي متوسط"> صناعي متوسط</option>
                    <option value="زراعي"> زراعي</option>
                    <option value="فندقي"> فندقي</option>
                </select>
            </div>
            <div class="col-md-6" id="supportDiv" style="display: none;">
                <label>حالة الدعم:</label>
                <div class="d-flex align-items-center">
                    <label class="me-3"><input type="radio" name="IsSupported" value="true" checked /> مدعوم</label>
                    <label><input type="radio" name="IsSupported" value="false" /> غير مدعوم</label>
                </div>
            </div>


        </div>





        <!-- <div class="form-group row">

             <div class="col-md-6">
                 <div class="section" id="rateDiv">
                     <label>أدخل الاستهلاك (kWh):</label>
                     <input id="rateConsumption" type="number" class="form-control" placeholder="أدخل قيمة الاستهلاك" />
                     <div id="rateResult"></div>
                 </div>
             </div>


             <div class="col-md-6" id="systemSizeDiv">
                 <div class="form-group">
                     <label for="systemSize">System Size (kW):</label>
                     <input type="number" id="systemSize" class="form-control" value="0.0">
                 </div>
             </div>

         </div>
          -->



        <div class="form-group row">
            <div class="col-md-6" id="MechanismsForConnecting">
                <label for="mechanisms">الآلية المتاحة حسب نوع الاشتراك:</label>
                <select id="mechanisms">
                    <option value="">اختر الآلية المتاحة</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="daytimePercentage">نسبة الاستهلاك النهاري (%):</label>
                <input id="daytimePercentage" type="number" class="form-control" placeholder="أدخل نسبة الاستهلاك النهاري" value="25" />
            </div>
        </div>


        <div class="form-group row">
            <div class="col-md-6 form-group">

                <label for="location">Location:</label>
                <select id="location">
                    <option value="0">اختر المنطقة  </option>
                    <option value="Amman"> عمان (تابع لأمانة عمان الكبرى)</option>
                    <option value="Amman2"> عمان (غير تابع لأمانة عمان الكبرى)</option>
                    <option value="Irbid">اربد</option>
                    <option value="Jerash">جرش </option>
                    <option value="Ajloun">عجلون </option>
                    <option value="Al-Zarqa">الزرقاء </option>
                    <option value="Al-Mafraq">المفرق </option>
                    <option value="Ma'an">معان</option>
                    <option value="Karak">الكرك</option>
                    <option value="Tafila">الطفيلة</option>
                    <option value="Al-Salt">السلط</option>

                    <option value="Aqaba">العقبة </option>
                </select>
            </div>
            <div class="col-md-6 form-group">

                <label for="performanceRatio">Performance Ratio:</label>
                <input type="number" id="performanceRatio" value="0.7" step="0.01" min="0.60" max="0.85">
            </div>
        </div>


        <button id="calculateButton" class="btn btn-primary">احسب معدل الاستهلاك الآن</button>




        <!-- قسم كامل السنة -->
        <div class="section hidden" id="yearDiv">
            @* <h4>المقارنة السنوية للطاقة (Yearly Energy Comparison)</h4> *@
            <table>
                <thead>
                    <tr>
                        <th scope="col">الشهر</th>
                        <th scope="col">
                            الطاقة المتوقع إنتاجها (kWh)
                            <span class="info-icon" onclick="showInfo('exportedEnergy')" aria-label="معلومات عن الطاقة المتوقع إنتاجها">
                                <i class="fas fa-info-circle"></i>
                            </span>
                        </th>
                        <th scope="col">
                            كمية الاستهلاك (kWh)
                            <span class="info-icon" onclick="showInfo('importedEnergy')" aria-label="معلومات عن كمية الاستهلاك">
                                <i class="fas fa-info-circle"></i>
                            </span>
                        </th>
                        <th scope="col">
                            القيمة المالية لكمية الاستهلاك (JD)
                            <span class="info-icon" onclick="showInfo('consumptionBeforeSolar')" aria-label="معلومات عن القيمة المالية للاستهلاك">
                                <i class="fas fa-info-circle"></i>
                            </span>
                        </th>
                        <th scope="col">
                            الطاقة المصدرة (kWh)
                            <span class="info-icon" onclick="showInfo('daytimeConsumption')" aria-label="معلومات عن الطاقة المصدرة">
                                <i class="fas fa-info-circle"></i>
                            </span>
                        </th>
                        <th scope="col">
                            الطاقة المستجرة (kWh)
                            <span class="info-icon" onclick="showInfo('nighttimeConsumption')" aria-label="معلومات عن الطاقة المستجرة">
                                <i class="fas fa-info-circle"></i>
                            </span>
                        </th>
                        <th scope="col">
                            قيمة الطاقة المصدرة (JD)
                            <span class="info-icon" onclick="showInfo('exportedValue')" aria-label="معلومات عن قيمة الطاقة المصدرة">
                                <i class="fas fa-info-circle"></i>
                            </span>
                        </th>
                        <th scope="col">
                            قيمة الطاقة المستجرة (JD)
                            <span class="info-icon" onclick="showInfo('importedValue')" aria-label="معلومات عن قيمة الطاقة المستجرة">
                                <i class="fas fa-info-circle"></i>
                            </span>
                        </th>
                        <th scope="col">
                            قيمة الاستهلاك المتوقع (JD)
                            <span class="info-icon" onclick="showInfo('difference')" aria-label="معلومات عن قيمة الاستهلاك المتوقع">
                                <i class="fas fa-info-circle"></i>
                            </span>
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < months.Count; i++)
                    {
                        int monthIndex = (startIndex + i) % months.Count;
                        <tr>
                            <td>@months[monthIndex]</td>
                            <td class="solar-value"></td> <!-- This will be filled dynamically -->
                            <td><input type="number" class="form-control imported-energy" data-index="@monthIndex" placeholder="0" /> </td>
                            <td><input type="text" readonly class="form-control" id="consumptionBeforeSolar-@monthIndex" /></td>
                            <td><input type="text" readonly class="form-control" id="daytimeConsumption-@monthIndex" /></td>
                            <td><input type="text" readonly class="form-control" id="nighttimeConsumption-@monthIndex" /></td>
                            <td><input type="text" readonly class="form-control exported-value" id="exportedValue-@monthIndex" /></td>
                            <td><input type="text" readonly class="form-control imported-value" id="importedValue-@monthIndex" /></td>
                            <td><input type="text" readonly class="form-control difference" id="difference-@monthIndex" /></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td>المجموع</td>
                        <td id="totalExportedEnergy">0</td>
                        <td id="totalImportedEnergy">0</td>
                        <td id="totalConsumptionBeforeSolar">0</td>
                        <td id="totalDaytimeConsumption">0</td>
                        <td id="totalNighttimeConsumption">0</td>
                        <td id="totalSolarValue">0</td>
                        <td id="totalImportedValue">0</td>
                        <td id="totalDifference">0</td>
                    </tr>
                    <tr>
                        <td>معدل الاستهلاك </td>
                        <td id="rateConsumption"><input type="text" /> </td>
                        <td>حجم النظام (حسب الاستهلاك)</td>
                        <td id="systemSize"><input type="text" /></td>
                        <td>النظام المسموح تركيبه (DC) </td>
                        <td id="allowSystemSize"><input type="text" /> </td>
                        <td>النظام المسموح تركيبه (AC) </td>

                        <td id="acSystmSize"><input type="number" placeholder="0" /></td>

                    </tr>
                    <tr>
                        <td> معدل إنتاج النظام </td>
                        <td id="rateProduction"><input type="text" /> </td>
                    </tr>
                </tfoot>
            </table>

        </div>



    </div>

    <div class="note">
        <i class="fas fa-info-circle"></i>
        <span>ملاحظة: جميع الأرقام المعروضة تقريبية وقد تختلف عن القيم الفعلية و القيم المالية غير شاملة للاقتطاعت الثابتة. الإشارة السالبة في الفرق تعني فائض.</span>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- إضافة مكتبة Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById("consumptionType").addEventListener("change", function () {
            var consumptionType = this.value;
            var consumptionTypeDiv = document.getElementById("consumptionTypeDiv");
            var supportDiv = document.getElementById("supportDiv");

            if (consumptionType === "منزلي") {
                // تغيير التصميم ليصبح كل منهما في نصف العرض
                consumptionTypeDiv.classList.remove("col-md-12");
                consumptionTypeDiv.classList.add("col-md-6");
                supportDiv.style.display = "block"; // إظهار حقل الدعم
            } else {
                // إعادة التصميم إلى العرض الكامل وإخفاء حقل الدعم
                consumptionTypeDiv.classList.remove("col-md-6");
                consumptionTypeDiv.classList.add("col-md-12");
                supportDiv.style.display = "none";
            }
        });

        // التأكد من الإعداد الافتراضي عند تحميل الصفحة
        window.onload = function () {
            var consumptionType = document.getElementById("consumptionType").value;
            var consumptionTypeDiv = document.getElementById("consumptionTypeDiv");
            var supportDiv = document.getElementById("supportDiv");

            if (consumptionType === "منزلي") {
                consumptionTypeDiv.classList.remove("col-md-12");
                consumptionTypeDiv.classList.add("col-md-6");
                supportDiv.style.display = "block";
            } else {
                consumptionTypeDiv.classList.remove("col-md-6");
                consumptionTypeDiv.classList.add("col-md-12");
                supportDiv.style.display = "none";
            }
        };
    </script>
    <script>
        const mechanisms={
            "منزلي": [ "آلية صافي القيمة (نفس الموقع الجغرافي)", "آلية التصدير الصفري","آلية تصدير الكل استجرار الكل", "انظمة تخزين البطاريات كأنظمة مرافقة" ],
             "زراعي": ["آلية صافي القيمة (نفس الموقع الجغرافي)","آلية صافي القيمة (خارج الموقع الجغرافي)", "آلية التصدير الصفري","آلية تصدير الكل استجرار الكل"],
        "صناعي صغير" :["آلية صافي القيمة (نفس الموقع الجغرافي)","آلية صافي القيمة (خارج الموقع الجغرافي)", "آلية التصدير الصفري","آلية تصدير الكل استجرار الكل"],
        "صناعي متوسط" :["آلية صافي القيمة (نفس الموقع الجغرافي)","آلية صافي القيمة (خارج الموقع الجغرافي)", "آلية التصدير الصفري","آلية تصدير الكل استجرار الكل"],
        "فندقي" :["آلية صافي القيمة (نفس الموقع الجغرافي)","آلية صافي القيمة (خارج الموقع الجغرافي)", "آلية التصدير الصفري","آلية تصدير الكل استجرار الكل"],

        "تجاري": ["آلية تصدير الكل استجرار الكل", "آلية التصدير الصفري"]

        };
             document.getElementById("consumptionType").addEventListener("change", function () {
            const sector = this.value;
            const mechanismSelect = document.getElementById("mechanisms");

            // تفريغ الخيارات السابقة
            mechanismSelect.innerHTML = '<option value="">اختر الآلية</option>';

            // إضافة الخيارات المتاحة بناءً على نوع القطاع
            if (mechanisms[sector]) {
                mechanisms[sector].forEach(mechanism => {
                    const option = document.createElement("option");
                    option.value = mechanism;
                    option.textContent = mechanism;
                    mechanismSelect.appendChild(option);
                });
            }
        });
    </script>
