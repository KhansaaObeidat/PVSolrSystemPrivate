                    console.log("System Size:", systemSizeValue, "Performance Ratio:", performanceRatio, "Selected Region:", selectedRegion);

                    if (!isNaN(systemSizeValue) && !isNaN(performanceRatio)) {
                        let totalSolarProduction = 0; // Initialize total solar production

                        document.querySelectorAll('.solar-value').forEach((solarValueCell, index) => {
                            const month = solarValueCell.closest('tr').querySelector('td').textContent.trim();
                            if (sunlightHoursData[month] && sunlightHoursData[month][selectedRegion]) {
