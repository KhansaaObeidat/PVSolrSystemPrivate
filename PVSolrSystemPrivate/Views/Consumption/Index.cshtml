                        });

                        // Update totalExportedEnergy with the total solar production
                        document.getElementById("totalExportedEnergy").innerText = totalSolarProduction.toFixed(0);

                        // Update average production
                        updateAverageProduction(totalSolarProduction);
                    }
                }
            }

            function calculateSolarValue(systemSize, sunlightHours, performanceRatio) {
                return systemSize * sunlightHours * performanceRatio;
            }

            function updateAverageProduction(totalSolarProduction) {
                // Calculate the average by dividing the total by 12
                const averageMonthlyProduction = totalSolarProduction / 12;
                console.log("Average Monthly Production:", averageMonthlyProduction);

                // Update the rate production input field
                const rateProductionInput = document.querySelector('#rateProduction input');
                if (rateProductionInput) {
                    rateProductionInput.value = averageMonthlyProduction.toFixed(2);
                    console.log("Updated Rate Production:", rateProductionInput.value);
                } else {
                    console.error("Rate Production input not found.");
