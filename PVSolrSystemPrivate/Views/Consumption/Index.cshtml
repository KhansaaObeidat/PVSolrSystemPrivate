            }

            // Attach event listener to the allowSystemSize input field
            const allowSystemSizeInputField = document.querySelector('#allowSystemSize input');
            const locationField = document.querySelector('#location');
            const performanceRatioField = document.querySelector('#performanceRatio');
            if (allowSystemSizeInputField || locationField || performanceRatioField) {
                allowSystemSizeInputField.addEventListener('input', updateSolarValues);
                locationField.addEventListener('input', updateSolarValues);
                performanceRatioField.addEventListener('input', updateSolarValues);
            }



            // Attach event listeners to consumption inputs
            document.querySelectorAll('.imported-energy').forEach(input => {
                input.addEventListener('input', updateSolarValues);
            });

            // Initial calculation
            updateSolarValues();
        });

    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Function to move focus to the input field directly below
            function focusBelowInput(event) {
                if (event.key === 'Enter') {
                    event.preventDefault(); // Prevent the default action of the Enter key
                    const inputs = Array.from(document.querySelectorAll('input'));
                    const currentIndex = inputs.indexOf(event.target);

                    if (currentIndex !== -1) {
                        const currentInput = inputs[currentIndex];
                        const currentRect = currentInput.getBoundingClientRect();

                        // Find the input directly below the current one
                        let belowInput = null;
                        let minDistance = Infinity;

                        inputs.forEach((input, index) => {
                            if (index !== currentIndex) {
                                const rect = input.getBoundingClientRect();
                                const distance = rect.top - currentRect.bottom;

                                if (distance > 0 && distance < minDistance) {
                                    minDistance = distance;
                                    belowInput = input;
                                }
                            }
                        });

                        if (belowInput) {
                            belowInput.focus();
                        }
                    }
                }
            }

            // Attach the event listener to each input field
            document.querySelectorAll('input').forEach(input => {
                input.addEventListener('keydown', focusBelowInput);
            });


                function updateAverageConsumption() {
                const consumptionInputs = document.querySelectorAll('.imported-energy');
                let totalConsumption = 0;
                let count = 0;

                consumptionInputs.forEach(input => {
                    const value = parseFloat(input.value);
                    if (!isNaN(value)) {
                        totalConsumption += value;
                        count++;
                    }
                });

                const averageConsumption = count > 0 ? totalConsumption / count : 0;

                const rateConsumptionInput = document.querySelector('#rateConsumption input');
                if (rateConsumptionInput) {
                    rateConsumptionInput.value = averageConsumption.toFixed(2);
                    updateSystemSize(); // Update system size whenever average consumption changes
                }
            }

            function updateSystemSize() {
                const rateConsumptionInput = document.querySelector('#rateConsumption input');
                const systemSizeInput = document.querySelector('#systemSize input');

                if (rateConsumptionInput && systemSizeInput) {
                    const rateConsumptionValue = parseFloat(rateConsumptionInput.value);
                    console.log("Rate Consumption Value:", rateConsumptionValue);

                    if (!isNaN(rateConsumptionValue) && rateConsumptionValue > 0) {
                        // افترض أن حجم النظام يعتمد على معدل الاستهلاك بطريقة معينة
                        const systemSize = rateConsumptionValue / 150; // مثال: قسمة معدل الاستهلاك على 150
                        systemSizeInput.value = systemSize.toFixed(2);
                        console.log("Updated System Size:", systemSizeInput.value);
                    } else {
                        systemSizeInput.value = ''; // Clear the input if the value is not a number or zero
                        console.error("Invalid or Zero Rate Consumption Value");
                    }
                }
            }

            // Attach the event listener to each consumption input field
            document.querySelectorAll('.imported-energy').forEach(input => {
                input.addEventListener('input', updateAverageConsumption);
            });


            // Call the function initially to set the average consumption and system size on page load
            updateAverageConsumption();

        });
    </script>





    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const isSupportedRadios = document.querySelectorAll('input[name="IsSupported"]');
            const yearDiv = document.getElementById("yearDiv");
            const daytimePercentageInput = document.getElementById("daytimePercentage");
            const importedEnergyInputs = document.querySelectorAll(".imported-energy");
            const mechanismSelect = document.getElementById("mechanisms");
            const calculateButton = document.getElementById('calculateButton');
                const startIndex = @startIndex;
                    const months = @Html.Raw(monthsJson); // Pass the serialized months list

            // Ensure solarValues is correctly serialized
            const solarValues = @Html.Raw(Json.Serialize(solarValues));

            if (calculateButton && yearDiv) {
                calculateButton.addEventListener('click', function() {
                    yearDiv.style.display = 'block'; // Show the table
                });
            }

            function calculateDayAndNightConsumption(totalConsumption, daytimePercentage, mechanism) {

                let daytimeConsumption = 0;
                let nighttimeConsumption = 0;

                if (mechanism === "آلية صافي القيمة (نفس الموقع الجغرافي)") {
                    daytimeConsumption = (daytimePercentage / 100) * totalConsumption;
                    nighttimeConsumption = totalConsumption - daytimeConsumption;
                } else if (mechanism === "آلية تصدير الكل استجرار الكل") {
                    nighttimeConsumption = totalConsumption;
                }else if(mechanism === "آلية التصدير الصفري"){

                     daytimeConsumption = (daytimePercentage / 100) * totalConsumption;

                    nighttimeConsumption = totalConsumption - daytimeConsumption;
                }

                return { daytimeConsumption, nighttimeConsumption };
            }

                                   function calculateBill(consumption, isSupported, consumptionType) {
                                          if (consumptionType === "منزلي") {
                                              if (isSupported) {
                                                  if (consumption <= 300) {
                                                      return consumption * 0.050; // 5 قروش
                                                  } else if (consumption <= 600) {
                                                      return (300 * 0.050) + ((consumption - 300) * 0.100); // 300 كيلو بسعر 5 قروش و300 كيلو بسعر 10 قروش
                                                  } else {
                                                      return (300 * 0.050) + (300 * 0.100) + ((consumption - 600) * 0.200); // أكثر من 600 كيلو بسعر 20 قرش
                                                  }
                                              } else {
                                                  if (consumption <= 1000) {
                                                      return consumption * 0.120; // 12 قرش
                                                  } else {
                                                      return (1000 * 0.120) + ((consumption - 1000) * 0.150); // أكثر من 1000 كيلو بسعر 15 قرش
                                                  }
                                              }
                                          }
                                               else if (consumptionType === "تجاري") {
                                              if (consumption <= 2000) {
                                                  return consumption * 0.120; // 12 قرش
                                              } else {
                                                  return (2000 * 0.120) + ((consumption - 2000) * 0.152); // أكثر من 2000 كيلو بسعر 152 فلس
                                              }
                                          } else if (consumptionType === "صناعي صغير") {
                                              if (consumption <= 10000) {
                                                  return consumption * 0.060; // 60 فلس
                                              } else {
                                                  return (10000 * 0.060) + ((consumption - 10000) * 0.068); // أكثر من 10000 كيلو بسعر 68 فلس
                                              }
                                          }else if (consumptionType === "صناعي متوسط") {
                                           if (consumption <= 10000) {
                                                  return consumption * 0.060; // 60 فلس
                                              } else {
                                                  return (10000 * 0.060) + ((consumption - 10000) * 0.068); // أكثر من 10000 كيلو بسعر 68 فلس
                                              }
                                          }else if(consumptionType === "زراعي"){
                                          return consumption * 0.055;
                                          }
                                          else if(consumptionType==="فندقي"){
                                          return consumption *0.082;
                                          }

                                          return 0; // في حال لم يتم تحديد نوع الاستهلاك
                                      }


                                   function calculateExportedValue(exportedEnergy, consumptionType) {
                                                 let rate = 0;

                                                 if (consumptionType === "منزلي") {
                                                     rate = 0.050; // 50 فلس
                                                 } else if (consumptionType === "تجاري" || consumptionType === "صناعي صغير" || consumptionType === "صناعي متوسط" || consumptionType === "زراعي" || consumptionType === "فندقي") {
                                                     rate = 0.040; // 40 فلس
                                                 }

                                                 return exportedEnergy * rate; // حساب القيمة المالية للطاقة المصدرة
                                             }


                                   function updateYearCalculation() {
                                          const isSupported = document.querySelector('input[name="IsSupported"]:checked').value === "true";
                                          const daytimePercentage = parseFloat(daytimePercentageInput.value) || 0;
                                          const consumptionType = document.getElementById("consumptionType").value;
                                            const consumptionTypeSelect = document.querySelector('#consumptionType');
                                             const mechanism = document.getElementById("mechanisms").value;

                                          let totalDaytimeConsumption = 0;
                                          let totalNighttimeConsumption = 0;
                                          let totalExportedEnergy = 0;
                                          let totalSolarValue = 0;
                                          let totalImportedEnergy = 0;
                                          let totalImportedValue = 0;
                                          let totalDifference = 0;
                                          let totalConsumptionBeforeSolar = 0;
                                                 // Calculate total solar production directly from .solar-value elements
                                              let totalSolarProduction = 0;
                                              document.querySelectorAll('.solar-value').forEach(solarValueCell => {
                                                  const solarProduction = parseFloat(solarValueCell.textContent) || 0;
                                                  totalSolarProduction += solarProduction;
                                              });
                                                      totalExportedEnergy += totalSolarProduction;
                                                              const averageMonthlyProduction = totalSolarProduction / 12;

                                              // تحديث حقل معدل الإنتاج إذا كان موجودًا
                                              const rateProductionInput = document.querySelector('#rateProduction input');
                                              if (rateProductionInput) {
                                                  rateProductionInput.value = averageMonthlyProduction.toFixed(2);
                                              }


                                          importedEnergyInputs.forEach((input, index) => {

                                                  const monthIndex = (startIndex + index) % months.length; // Adjust index to start from the previous month

                                                const solarValueCell = input.closest('tr').querySelector('.solar-value');
                                                 const solarProduction = parseFloat(solarValueCell.textContent) || 0; // الطاقة المنتجة لهذا الشهر
                                                  const totalConsumption = parseFloat(input.value) || 0;
                                                    if (totalConsumption < 0) {
                                                      input.value = 0;
                                                  }

                                              if (totalConsumption === 0) {
                                                  // إذا لم يتم إدخال أي قيمة
                                                  document.getElementById(`exportedValue-${monthIndex}`).value = '';
                                                  document.getElementById(`daytimeConsumption-${monthIndex}`).value = '';
                                                  document.getElementById(`nighttimeConsumption-${monthIndex}`).value = '';
                                                  document.getElementById(`importedValue-${monthIndex}`).value = '';
                                                  document.getElementById(`difference-${monthIndex}`).value = '';
                                                  document.getElementById(`consumptionBeforeSolar-${monthIndex}`).value = '';
                                                  return;
                                              }

                                              // حساب الطاقة المستهلكة نهارًا وليلًا
                                              const { daytimeConsumption, nighttimeConsumption } = calculateDayAndNightConsumption(totalConsumption, daytimePercentage, mechanism);
                                                     // حساب الطاقة المصدرة والمستجرة
                                                   let exportedEnergy = 0;
                                                   let adjustedNighttimeConsumption = 0;
                                              if(mechanism==="آلية تصدير الكل استجرار الكل"){
                                                      exportedEnergy = solarProduction - daytimeConsumption;
                                                    adjustedNighttimeConsumption = nighttimeConsumption;
                                                      if (exportedEnergy < 0) {
                                                  // إذا كانت الطاقة المصدرة سالبة، يتم تصفير الطاقة المصدرة وإضافة الفرق إلى الاستهلاك الليلي
                                                  adjustedNighttimeConsumption += Math.abs(exportedEnergy);
                                                  exportedEnergy = 0; // تصفير الطاقة المصدرة
                                              }
                                              }else if(mechanism==="آلية صافي القيمة (نفس الموقع الجغرافي)"){
                                                      exportedEnergy = solarProduction - daytimeConsumption;
                                                    adjustedNighttimeConsumption = nighttimeConsumption;
                                                      if (exportedEnergy < 0) {
                                                  // إذا كانت الطاقة المصدرة سالبة، يتم تصفير الطاقة المصدرة وإضافة الفرق إلى الاستهلاك الليلي
                                                  adjustedNighttimeConsumption += Math.abs(exportedEnergy);
                                                  exportedEnergy = 0; // تصفير الطاقة المصدرة
                                              }
                                              }else if(mechanism==="آلية التصدير الصفري"){
                                                           exportedEnergy = solarProduction - daytimeConsumption;
                                                    adjustedNighttimeConsumption = nighttimeConsumption;
                                                      if (exportedEnergy < 0) {
                                                  // إذا كانت الطاقة المصدرة سالبة، يتم تصفير الطاقة المصدرة وإضافة الفرق إلى الاستهلاك الليلي
                                                  adjustedNighttimeConsumption += Math.abs(exportedEnergy);
                                                  exportedEnergy = 0; // تصفير الطاقة المصدرة
                                              }
                                                 exportedEnergy = 0; // تصفير الطاقة المصدرة

                                              }



                                              if (exportedEnergy < 0) {
                                                  // إذا كانت الطاقة المصدرة سالبة، يتم تصفير الطاقة المصدرة وإضافة الفرق إلى الاستهلاك الليلي
                                                  adjustedNighttimeConsumption += Math.abs(exportedEnergy);
                                                  exportedEnergy = 0; // تصفير الطاقة المصدرة
                                              }

                                              // التأكد أن الطاقة المصدرة لا تعكس الاستهلاك الشهري
                                              exportedEnergy = Math.max(0, exportedEnergy);

                                              // حساب القيم المالية للطاقة المصدرة والمستجرة
                                              const exportedValue = calculateExportedValue(exportedEnergy, consumptionType);
                                              const importedValue = calculateBill(adjustedNighttimeConsumption, isSupported, consumptionType);

                                              // حساب الفرق والفاتورة قبل الطاقة الشمسية
                                              const difference = importedValue - exportedValue;
                                              const consumptionBeforeSolar = calculateBill(totalConsumption, isSupported, consumptionType);

                                              // تحديث المجموعات
                                              totalDaytimeConsumption += daytimeConsumption;
                                              totalNighttimeConsumption += adjustedNighttimeConsumption;
                                              totalSolarValue += exportedValue;
                                              totalImportedEnergy += totalConsumption;
                                              totalImportedValue += importedValue;
                                              totalDifference += difference;
                                              totalConsumptionBeforeSolar += consumptionBeforeSolar;

                                              // تحديث القيم في الجدول
                                              document.getElementById(`exportedValue-${monthIndex}`).value = exportedValue.toFixed(2);
                                              document.getElementById(`daytimeConsumption-${monthIndex}`).value = exportedEnergy;
                                              document.getElementById(`nighttimeConsumption-${monthIndex}`).value = adjustedNighttimeConsumption;
                                              document.getElementById(`importedValue-${monthIndex}`).value = importedValue.toFixed(2);
                                              document.getElementById(`difference-${monthIndex}`).value = difference.toFixed(2);
                                              document.getElementById(`consumptionBeforeSolar-${monthIndex}`).value = consumptionBeforeSolar.toFixed(2);
                                          });

                                          // تحديث القيم الإجمالية في الجدول
                                          document.getElementById("totalDaytimeConsumption").innerText = totalDaytimeConsumption.toFixed(2);
                                          document.getElementById("totalNighttimeConsumption").innerText = totalNighttimeConsumption.toFixed(2);
                                          document.getElementById("totalExportedEnergy").innerText = totalExportedEnergy;
                                          document.getElementById("totalSolarValue").innerText = totalSolarValue.toFixed(2);
                                          document.getElementById("totalImportedEnergy").innerText = totalImportedEnergy.toFixed(2);
                                          document.getElementById("totalImportedValue").innerText = totalImportedValue.toFixed(2);
                                          document.getElementById("totalDifference").innerText = totalDifference.toFixed(2);
                                          document.getElementById("totalConsumptionBeforeSolar").innerText = totalConsumptionBeforeSolar.toFixed(2);

                                          // تحديث الرسم البياني

                                      }

            function recalculateAll() {
                updateYearCalculation();
            }

            isSupportedRadios.forEach(radio => {
                radio.addEventListener("change", recalculateAll);
            });


            daytimePercentageInput.addEventListener("input", recalculateAll);
            importedEnergyInputs.forEach(input => {
                input.addEventListener("input", updateYearCalculation);
            });

            document.getElementById("consumptionType").addEventListener("change", function() {
                updateYearCalculation();
            });
            document.getElementById("mechanisms").addEventListener("change",function(){
            updateYearCalculation();
            });
            document.getElementById("allowSystemSize").addEventListener("change",function(){
                 calculateDayAndNightConsumption();  });

        });
    </script>
