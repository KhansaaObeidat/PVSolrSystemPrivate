@using Azure.Core
@using PVSolrSystemPrivate.Models
@model PVSolrSystemPrivate.Models.ViewModels.SearchViewModel

@{
    ViewData["Title"] = "Index";
}

<head>
    <!-- ... existing head content ... -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>

<style>
    body {
        background-color: #f8f9fa;
        font-family: Arial, sans-serif;
    }

    h1 {
        text-align: center;
        margin-bottom: 40px;
        font-weight: bold;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .table {
        margin-top: 20px;
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .btn {
        margin-right: 5px;
        transition: all 0.2s ease-in-out;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        border-radius: 15px;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
    }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

    .form-control {
        border-radius: 10px;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    th, td {
        text-align: center;
    }

    .searchInput {
        padding: 8px;
        border-radius: 15px;
    }

    .pagination {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

        .pagination a {
            margin: 0 5px;
            padding: 10px 15px;
            border-radius: 5px;
            text-decoration: none;
            color: white;
            background-color: #007bff; /* لون الخلفية */
            transition: background-color 0.3s;
        }

            .pagination a:hover {
                background-color: #0056b3; /* لون الخلفية عند التمرير */
            }

        .pagination .active {
            background-color: #0056b3; /* لون الخلفية للزر النشط */
            pointer-events: none; /* منع التفاعل مع الزر النشط */
        }
</style>



<!-- Add the anti-forgery token -->
@Html.AntiForgeryToken()
<div class="container py-5">
    <h1 class="text-center">إدارة العملاء</h1>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a class="btn btn-primary" href="/Customers/Create">
            <i class="fas fa-plus-circle"></i> إضافة عميل جديد
        </a>
        <form id="searchForm" method="get" asp-action="Index">
            <input class="searchInput" type="text" id="searchInput" name="SearchString" placeholder="بحث..." autocomplete="off" />
        </form>
    </div>



  <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
 <table class="table " id="customersTable">
        <thead class="thead-dark">
            <tr>
                <th scope="col">@Html.DisplayNameFor(model => model.Customers.First().CustomerName)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Customers.First().PhoneNumber)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Customers.First().SubscriptionNumber)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Customers.First().Phase)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Customers.First().Location)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Customers.First().Notes)</th>
                <th scope="col">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Customers)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.CustomerName)</td>
                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                    <td>@Html.DisplayFor(modelItem => item.SubscriptionNumber)</td>
                    <td>@Html.DisplayFor(modelItem => item.Phase)</td>
                    <td>@Html.DisplayFor(modelItem => item.Location)</td>
                    <td>@Html.DisplayFor(modelItem => item.Notes)</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-warning btn-sm" title="تعديل">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-info btn-sm" title="عرض التفاصيل">
                            <i class="bi bi-info-circle-fill"></i>
                        </a>
                        <a href="#" class="btn btn-danger btn-sm delete-btn"
                           data-customer-id="@item.CustomerId" data-toggle="modal" data-target="#deleteModal">
                            <i class="bi bi-trash"></i>
                        </a>
                        <a asp-action="Profile" asp-route-id="@item.CustomerId" class="btn btn-primary btn-sm" title="الصفحة الشخصية">
                            <i class="bi bi-person"></i> الصفحة الشخصية
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

                    </div></div></div>
   

    <!-- Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">تأكيد الحذف</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    هل أنت متأكد أنك تريد حذف هذا العنصر؟
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-danger" id="confirmDelete">حذف</button>
                </div>
            </div>
        </div>
    </div>

    <div class="pagination">
        @if (ViewBag.CurrentPage > 1)
        {
            <a class="btn btn-secondary" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, SearchString = Model.SearchString })">السابق</a>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a class="btn btn-secondary @((i == ViewBag.CurrentPage) ? "active" : "")" href="@Url.Action("Index", new { page = i, SearchString = Model.SearchString })">@i</a>
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a class="btn btn-secondary" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, SearchString = Model.SearchString })">التالي</a>
        }
    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let customerIdToDelete;
    const searchInput = document.getElementById("searchInput");
    const customersTableBody = document.querySelector("#customersTable tbody");
        // Get the anti-forgery token from the hidden field
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // Set customerIdToDelete when the delete button is clicked
        document.querySelectorAll(".delete-btn").forEach(button => {
            button.addEventListener("click", function () {
                customerIdToDelete = this.getAttribute("data-customer-id");
            });
        });

        // Handle confirm delete
        document.getElementById("confirmDelete").addEventListener("click", function () {
            if (customerIdToDelete) {
                // Use fetch to send a POST request
                fetch(`/Customers/Delete/${customerIdToDelete}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken // Send the token in the header
                    },
                    body: JSON.stringify({
                        CustomerId: customerIdToDelete
                    })
                })
                .then(response => {
                    if (response.ok) {
                        Toastify({
                            text: "تم الحذف بنجاح",
                            duration: 3000,
                            gravity: "top",
                            position: "right",
                            backgroundColor: "green",
                        }).showToast();
                        location.reload(); // Reload the page to reflect the change
                    } else {
                        Toastify({
                            text: "حدث خطأ أثناء الحذف!",
                            duration: 3000,
                            gravity: "top",
                            position: "right",
                            backgroundColor: "red",
                        }).showToast();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Toastify({
                        text: "حدث خطأ أثناء الاتصال بالخادم!",
                        duration: 3000,
                        gravity: "top",
                        position: "right",
                        backgroundColor: "red",
                    }).showToast();
                });
            }

            // Close the modal
            $('#deleteModal').modal('hide');
        });
    searchInput.addEventListener("input", function () {
         const query = this.value;

         // إرسال طلب AJAX إلى الخادم
         fetch(`/Customers?SearchString=${encodeURIComponent(query)}`, {
             method: "GET",
             headers: {
                 "X-Requested-With": "XMLHttpRequest"
             }
         })
             .then(response => {
                 if (response.ok) {
                     return response.json(); // نحصل على البيانات بصيغة JSON
                 }
                 throw new Error("Error fetching search results");
             })
             .then(data => {
                 // تفريغ محتويات الجدول الحالية
                 customersTableBody.innerHTML = "";

                 // إعادة بناء الجدول بالبيانات الجديدة
                 data.forEach(customer => {
                     const row = document.createElement("tr");
                     row.innerHTML = `
                         <td>${customer.customerName}</td>
                         <td>${customer.phoneNumber}</td>
                         <td>${customer.subscriptionNumber}</td>
                         <td>${customer.phase}</td>
                         <td>${customer.location}</td>
                         <td>${customer.notes}</td>
                         <td class="text-center">
                             <a href="/Customers/Edit/${customer.customerId}" class="btn btn-warning btn-sm" title="تعديل">
                                 <i class="bi bi-pencil-fill"></i>
                             </a>
                             <a href="/Customers/Details/${customer.customerId}" class="btn btn-info btn-sm" title="عرض التفاصيل">
                                 <i class="bi bi-info-circle-fill"></i>
                             </a>
                             <a href="#" class="btn btn-danger btn-sm delete-btn" data-customer-id="${customer.customerId}">
                                 <i class="bi bi-trash"></i>
                             </a>
                  
                         </td>
                     `;
                     customersTableBody.appendChild(row);
                 });
             })
             .catch(error => {
                 console.error("Error:", error);
             });
     });
    });
</script>
